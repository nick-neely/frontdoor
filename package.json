  "scripts": {
    "broadcast": "tsx --env-file-if-exists=.env scripts/broadcast.mts",
    "build": "pnpm content && vite build",
    "check": "pnpm content && ultracite check --type-aware --type-check",
    "content": "content-collections build",
    "dev": "pnpm content && vite dev --port 3000",
    "email": "email dev --dir src/emails --port 3001",
