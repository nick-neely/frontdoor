    "prepare": "content-collections build",
    "seo:verify": "node --experimental-strip-types scripts/verify-seo-output.mjs",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm seo:verify"
  },
