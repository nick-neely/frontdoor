    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
