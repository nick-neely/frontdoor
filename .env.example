# Newsletter delivery. See docs/adr/0002-stateless-double-opt-in.md.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Signs newsletter confirmation links. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every confirmation link currently in flight.
NEWSLETTER_SIGNING_SECRET=

# Reads GitHub activity for the home page status line. Needs repository read
# access so private pushes are counted; private repository names are never
# rendered. Server-side only, never exposed to the client bundle.
GITHUB_ACTIVITY_TOKEN=
